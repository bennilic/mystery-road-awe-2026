{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "type": "shell",
      "command": "NO_COLOR=1 npx vite --port 8080 --strictPort --host 127.0.0.1",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:\\s+http"
        }
      }
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "NO_COLOR=1 npm run server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "node server/index.ts",
          "endsPattern": "\\[backend\\] read-only API on"
        }
      }
    },
    {
      "label": "Serve all",
      "dependsOn": ["Backend", "Serve"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Stop server",
      "type": "shell",
      "command": "pkill -f 'vite --port 8080' || true; pkill -f 'node server/index.ts' || true",
      "problemMatcher": []
    },
    {
      "label": "Stop Chrome",
      "type": "shell",
      "command": "pkill -f 'user-data-dir=/tmp/remotion-chrome-profile' || true",
      "problemMatcher": []
    },
    {
      "label": "Stop all",
      "dependsOn": ["Stop server", "Stop Chrome"],
      "problemMatcher": []
    },
    {
      "label": "Run in Chrome (no debug)",
      "dependsOn": "Serve all",
      "type": "shell",
      "command": "open -a 'Google Chrome' http://localhost:8080",
      "problemMatcher": []
    }
  ]
}
