{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "type": "shell",
      "command": "npx vite --port 8080 --strictPort --host 127.0.0.1",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Stop server",
      "type": "shell",
      "command": "pkill -f 'vite --port 8080' || true",
      "problemMatcher": []
    },
    {
      "label": "Stop Chrome",
      "type": "shell",
      "command": "pkill -f 'user-data-dir=/tmp/remotion-chrome-profile' || true",
      "problemMatcher": []
    },
    {
      "label": "Stop all",
      "dependsOn": ["Stop server", "Stop Chrome"],
      "problemMatcher": []
    },
    {
      "label": "Run in Chrome (no debug)",
      "dependsOn": "Serve",
      "type": "shell",
      "command": "open -a 'Google Chrome' http://localhost:8080",
      "problemMatcher": []
    }
  ]
}
